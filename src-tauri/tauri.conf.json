{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rustranscript",
  "mainBinaryName": "rstt",
  "version": "0.1.0",
  "identifier": "io.github.petebarbosa.rustranscript",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Rustranscript",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#07080c",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:5173"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Productivity",
    "shortDescription": "Record and transcribe your meetings locally",
    "longDescription": "Records your calls, transcribes them and separates the speakers. Everything stays on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
